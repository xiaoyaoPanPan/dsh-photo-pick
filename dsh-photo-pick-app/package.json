{
  "name": "dsh-photo-pick-app",
  "description": "Installable dsh profile bundle: photo-pick (ctx.photoPick) plus a shippable photo-pick agent preset",
  "version": "0.1.0-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-photo-pick-setup-preset": "./lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./bin": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/bin.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/bin.js",
    "cordis.patch.yml",
    "agent-presets/**",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyaoPanPan/dsh-photo-pick.git",
    "directory": "dsh-photo-pick-app"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "test": "vitest run",
    "prepare": "node -e \"require('node:fs').accessSync('lib/index.js')\""
  },
  "dependencies": {
    "dsh-photo-pick": "github:xiaoyaoPanPan/dsh-photo-pick#path:dsh-photo-pick",
    "dsh-photo-pick-local": "github:xiaoyaoPanPan/dsh-photo-pick#path:dsh-photo-pick-local",
    "dsh-photo-pick-ui": "github:xiaoyaoPanPan/dsh-photo-pick#path:dsh-photo-pick-ui",
    "dsh-tool-photo-pick": "github:xiaoyaoPanPan/dsh-photo-pick#path:dsh-tool-photo-pick"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-invariants": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "js-yaml": "^4.1.0",
    "vitest": "^3.2.4",
    "tsdown": "^0.22.2"
  },
  "author": {
    "name": "xiaoyaoPanPan",
    "url": "https://github.com/xiaoyaoPanPan"
  },
  "bugs": {
    "url": "https://github.com/xiaoyaoPanPan/dsh-photo-pick/issues"
  },
  "homepage": "https://github.com/xiaoyaoPanPan/dsh-photo-pick#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "photo",
    "vision",
    "ranking",
    "plugin"
  ]
}
