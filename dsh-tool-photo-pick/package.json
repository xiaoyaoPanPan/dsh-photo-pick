{
  "name": "dsh-tool-photo-pick",
  "description": "Model-facing photo_pick_best tool over ctx.photoPick",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyaoPanPan/dsh-photo-pick.git",
    "directory": "dsh-tool-photo-pick"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b && tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "dsh-photo-pick": "file:../dsh-photo-pick"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "dsh-photo-pick": "file:../dsh-photo-pick",
    "vitest": "^3.2.4",
    "tsdown": "^0.22.2"
  },
  "author": {
    "name": "xiaoyaoPanPan",
    "url": "https://github.com/xiaoyaoPanPan"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xiaoyaoPanPan/dsh-photo-pick/issues"
  },
  "homepage": "https://github.com/xiaoyaoPanPan/dsh-photo-pick#readme"
}
