{
  "name": "dsh-photo-pick-local",
  "description": "Local photo-pick provider: workspace path containment, vision quality scoring, optional mediaLibrary candidate search",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyaoPanPan/dsh-photo-pick.git",
    "directory": "dsh-photo-pick-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepare": "tsdown --config tsdown.prepare.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "dsh-photo-pick": "file:../dsh-photo-pick",
    "sharp": "^0.35.3",
    "tsdown": "^0.22.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-native-command": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-native-command": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*",
    "dsh-photo-pick": "file:../dsh-photo-pick",
    "sharp": "^0.35.3",
    "vitest": "^3.2.4"
  },
  "author": {
    "name": "xiaoyaoPanPan",
    "url": "https://github.com/xiaoyaoPanPan"
  },
  "bugs": {
    "url": "https://github.com/xiaoyaoPanPan/dsh-photo-pick/issues"
  },
  "homepage": "https://github.com/xiaoyaoPanPan/dsh-photo-pick#readme"
}
